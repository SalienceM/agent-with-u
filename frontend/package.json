{
  "name": "agent-with-u-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prepare:preview-assets": "node scripts/copy-preview-assets.mjs",
    "dev": "npm run prepare:preview-assets && vite",
    "build": "npm run prepare:preview-assets && tsc --noEmit && vite build",
    "test:home": "tsc -p tsconfig.home-tests.json && node --test tests/home/*.test.cjs",
    "qa:fixture": "python ../scripts/home_qa_fixture.py --profile typical",
    "qa:fixture:stress": "python ../scripts/home_qa_fixture.py --profile stress",
    "test:home:browser": "playwright test -c playwright.home.config.ts",
    "test:home:desktop": "playwright test -c playwright.home.config.ts --project=desktop-chromium --project=web-chromium tests/acceptance/home.desktop.spec.ts",
    "test:home:mobile": "playwright test -c playwright.home.config.ts --project=mobile-chromium --project=narrow-mobile-chromium tests/acceptance/home.mobile.spec.ts",
    "test:home:a11y": "playwright test -c playwright.home.config.ts --project=desktop-chromium tests/acceptance/home.accessibility.spec.ts",
    "test:home:performance": "playwright test -c playwright.home.config.ts --project=desktop-chromium tests/acceptance/home.performance.spec.ts",
    "test:home:performance:stress": "cross-env HOME_QA_PROFILE=stress playwright test -c playwright.home.config.ts --project=desktop-chromium tests/acceptance/home.performance.spec.ts",
    "test:home:browser:stress": "cross-env HOME_QA_PROFILE=stress playwright test -c playwright.home.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.5.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.6.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.26.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "codemirror": "^6.0.1",
    "docx-preview": "^0.4.0",
    "highlight.js": "^11.11.1",
    "marked": "^9.1.6",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.54.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
